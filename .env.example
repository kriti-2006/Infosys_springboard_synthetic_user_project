# Rename to .env and fill in
OPENROUTER_API_KEY=your_key_here

# Optional: tried first, before the built-in fallback list. Free OpenRouter
# model slugs get pulled/deprecated without warning, so every LLM call in
# this project automatically retries and falls back through a short list of
# free models (see FALLBACK_MODELS in llm.py) -- the pipeline only fails if
# every one of them fails. You usually don't need to set this at all.
# OPENROUTER_MODEL=openrouter/free
