# ---------- LLM (OpenRouter, unchanged from Milestone 2) ----------
OPENROUTER_API_KEY=your_key_here
# Optional: tried first, then falls back to openrouter/free (see llm.py)
# OPENROUTER_MODEL=openrouter/free
LLM_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=5

# ---------- Database (PostgreSQL + pgvector) ----------
# Matches docker-compose.yml. Plain postgresql:// is auto-converted to asyncpg.
DATABASE_URL=postgresql://persona:persona@localhost:5432/persona_platform
# Only used by the test-suite; falls back to a temp SQLite file if unset.
# TEST_DATABASE_URL=postgresql://persona:persona@localhost:5432/persona_platform_test

# ---------- Semantic memory (optional) ----------
# Set an OpenRouter-served embedding model to enable pgvector retrieval, e.g.
# EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_MODEL=
EMBEDDING_DIM=1536

# ---------- Survey/Interview execution ----------
PERSONA_CONCURRENCY=4
SURVEY_LLM_VALIDATION=true
MAX_RESPONSE_ATTEMPTS=2
MEMORY_TOP_K=6
INTERVIEW_WINDOW_TURNS=4

# ---------- API ----------
# If set, every /api request must send header X-API-Key: <value>
API_KEY=
RATE_LIMIT_PER_MINUTE=120
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
